# Copy to .env. Keep the real values in a password manager or secret store,
# and replace each placeholder with your store's reference to that entry.
# Run the tool through the store's CLI so the references resolve at launch.
#
# In GitHub Actions these come from encrypted secrets instead:
#   gh secret set ANTHROPIC_API_KEY
#   gh secret set GMAIL_ADDRESS
#   gh secret set GMAIL_APP_PASSWORD
# (gh secret set reads from stdin, so values never enter shell history.)

# console.anthropic.com/settings/keys → Create Key
# Shown only once at creation. If you lost it, make a new one.
ANTHROPIC_API_KEY=<reference to your Anthropic API key>

# Sender and recipient (same address is fine).
GMAIL_ADDRESS=<reference to your Gmail address>

# NOT your Google password. Generate at:
#   Google Account → Security → 2-Step Verification → App passwords
# Requires 2FA already enabled. 16 chars, mail-scoped, independently revocable.
GMAIL_APP_PASSWORD=<reference to your Gmail app password>
